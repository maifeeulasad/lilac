      <svg></svg>
    </button>
    <button aria-label="Italic (Ctrl+I)" aria-pressed="false" class="lilac-toolbar__button lilac-toolbar__button--disabled" data-tool="italic" disabled title="Italic (Ctrl+I)" type="button">
      <svg></svg>
    </button>
    <button aria-label="Underline (Ctrl+U)" aria-pressed="false" class="lilac-toolbar__button lilac-toolbar__button--disabled" data-tool="underline" disabled title="Underline (Ctrl+U)" type="button">
      <svg></svg>
    </button>
    <div aria-hidden="true" class="lilac-toolbar__separator"></div>
    <button aria-label="Heading 1" aria-pressed="false" class="lilac-toolbar__button lilac-toolbar__button--disabled" data-tool="heading1" disabled title="Heading 1" type="button">
      <svg></svg>
    </button>
    <button aria-label="Heading 2" aria-pressed="false" class="lilac-toolbar__button lilac-toolbar__button--disabled" data-tool="heading2" disabled title="Heading 2" type="button">
      <svg></svg>
    </button>
    <button aria-label="Heading 3" aria-pressed="false" class="lilac-toolbar__button lilac-toolbar__button--disabled" data-tool="heading3" disabled title="Heading 3" type="button">
      <svg></svg>
    </button>
    <button aria-label="Paragraph" aria-pressed="false" class="lilac-toolbar__button lilac-toolbar__button--disabled" data-tool="paragraph" disabled title="Paragraph" type="button">
      <svg></svg>
    </button>
    <div aria-hidden="true" class="lilac-toolbar__separator"></div>
    <button aria-label="Bullet List" aria-pressed="false" class="lilac-toolbar__button lilac-toolbar__button--disabled" data-tool="bulletList" disabled title="Bullet List" type="button">
      <svg></svg>
    </button>
    <button aria-label="Numbered List" aria-pressed="false" class="lilac-toolbar__button lilac-toolbar__button--disabled" data-tool="orderedList" disabled title="Numbered List" type="button">
      <svg></svg>
    </button>
    <button aria-label="Quote" aria-pressed="false" class="lilac-toolbar__button lilac-toolbar__button--disabled" data-tool="blockquote" disabled title="Quote" type="button">
      <svg></svg>
    </button>
    <div aria-hidden="true" class="lilac-toolbar__separator"></div>
    <button aria-label="Link (Ctrl+K)" aria-pressed="false" class="lilac-toolbar__button lilac-toolbar__button--disabled" data-tool="link" disabled title="Link (Ctrl+K)" type="button">
      <svg></svg>
    </button>
    <button aria-label="Code Block" aria-pressed="false" class="lilac-toolbar__button lilac-toolbar__button--disabled" data-tool="codeBlock" disabled title="Code Block" type="button">
      <svg></svg>
    </button>
  </div>
  <div class="lilac-editor__content-wrapper" style="min-height: 200px; max-height: 600px;">
    <div class="lilac-editor__placeholder" style="display: none;">Start writing...</div>
    <div aria-label="Text editor" aria-multiline="true" class="lilac-editor__content" data-testid="lilac-editor-content" role="textbox">
      <p>locked</p>
    </div>
  </div>
</div>"
`;

exports[`editor shell > renders without a toolbar when asked > no toolbar 1`] = `
"<div class="lilac-editor lilac-editor--light lilac-editor--empty">
  <div class="lilac-editor__content-wrapper" style="min-height: 200px; max-height: 600px;">
    <div class="lilac-editor__placeholder" style="display: block;">Start writing...</div>
    <div aria-label="Text editor" aria-multiline="true" class="lilac-editor__content" data-testid="lilac-editor-content" role="textbox"></div>
  </div>
</div>"
`;
