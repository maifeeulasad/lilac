{
  "name": "lilac-wysiwyg/lilac",
  "description": "PHP and Laravel integration for the Lilac WYSIWYG editor — render the editor from server-side PHP or a Blade component.",
  "type": "library",
  "license": "MIT",
  "keywords": ["wysiwyg", "editor", "laravel", "blade", "php", "lilac"],
  "homepage": "https://github.com/maifeeulasad/lilac",
  "authors": [
    { "name": "Maifee Ul Asad", "email": "maifeeulasad@gmail.com" }
  ],
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "illuminate/support": "^10.0 || ^11.0 || ^12.0",
    "illuminate/view": "^10.0 || ^11.0 || ^12.0"
  },
  "suggest": {
    "illuminate/support": "Enables the Laravel <x-lilac /> Blade component and auto-discovered service provider."
  },
  "autoload": {
    "psr-4": {
      "Lilac\\": "php/src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Lilac\\LilacServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
