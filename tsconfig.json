{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./core",
    "baseUrl": "./",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // NodeNext makes the compiler require explicit file extensions on relative
    // specifiers, so a missing ".js" fails the build instead of shipping a
    // package that cannot be imported under Node (see #23).
    "moduleResolution": "NodeNext"
  },
  "include": [
    "core/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "adapter/**/*"
  ]
}