{
  "name": "@lilac-wysiwyg/core",
  "version": "0.5.0",
  "description": "Lilac - a smooth, modern WYSIWYG text editor built with pure TypeScript. Zero dependencies, framework-agnostic, with a clean interface and elegant typography.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "access": "public",
  "scripts": {
    "dev": "tsc -w",
    "dev:server": "npx http-server . -p 3000 -c-1",
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "build:adapters": "pnpm run build:scripts && node dist-scripts/script/build-adapters.js",
    "verify:packaging": "pnpm run build:scripts && node dist-scripts/script/verify-packaging.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "pnpm run test && pnpm run typecheck && pnpm run test:e2e"
  },
  "keywords": [
    "wysiwyg",
    "editor",
    "text-editor",
    "typescript",
    "rich-text",
    "vanilla-js",
    "framework-agnostic",
    "rich-text",
    "contenteditable",
    "zero-dependencies",
    "react",
    "vue",
    "svelte",
    "angular"
  ],
  "author": "Maifee Ul Asad<maifeeulasad@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maifeeulasad/lilac.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.59.0",
    "@types/node": "^24.1.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.0",
    "typescript": "^5.0.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}
